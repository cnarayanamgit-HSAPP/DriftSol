# Postgres
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=mlflow
POSTGRES_DB=mlflow
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka
KAFKA_PORT=9092
KAFKA_UI_PORT=8080

# MLflow
MLFLOW_PORT=5000
MLFLOW_BACKEND_STORE_URI=postgresql://mlflow:mlflow@postgres:5432/mlflow
MLFLOW_ARTIFACT_ROOT=s3://mlflow/artifacts   # or local path if you prefer
MLFLOW_S3_ENDPOINT_URL=http://minio:9000     # only if you later add MinIO

# General
COMPOSE_PROJECT_NAME=ml_local
